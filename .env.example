# Get a free TomTom API key: https://developer.tomtom.com/user/login
TOMTOM_API_KEY=your_key_here
# Twilio alert delivery (optional): use an SMS number or a WhatsApp-enabled sender.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WhatsApp approved template Content SIDs. OTP uses the Two-Factor Authentication template.
TWILIO_WHATSAPP_OTP_CONTENT_SID=HXfe5ab5f00277942d4d4200328b4d403c
# Optional approved crop-spoilage template; leave blank to use a normal WhatsApp body.
TWILIO_WHATSAPP_ALERT_CONTENT_SID=
