# Get a free TomTom API key: https://developer.tomtom.com/user/login
TOMTOM_API_KEY=your_key_here
# Wappfly WhatsApp API token. Keep this only in .env, never in source code.
WAPPFLY_API_TOKEN=your_rotated_wappfly_token
# Twilio alert delivery (optional): use an SMS number or a WhatsApp-enabled sender.
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WhatsApp approved template Content SIDs. OTP uses the Two-Factor Authentication template.
TWILIO_WHATSAPP_OTP_CONTENT_SID=HX25161c213d71bb75e073ead06f38fbbd
# ISRO Bhuvan Satellite LULC API (can be updated in Render Environment Variables)
BHUVAN_API_TOKEN=4693c1e682a873ca92837b3e63047c927f664642
BHUVAN_API_URL=https://bhuvan-app1.nrsc.gov.in/api/lulc/curl_aoi.php
